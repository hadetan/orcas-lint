{
  "project": ["src/**/*.{ts,tsx}"],
  "entry": ["src/index.ts", "src/cli/index.ts"],
  "ignore": ["**/*.d.ts"],
  "rules": {
    "dead-import": "error",
    "dead-export": "error"
  },
  "ignoreBinaries": [
    "@types/node",
    "@vitest/coverage-v8",
    "oxlint",
    "prettier",
    "publint",
    "tsup",
    "typescript",
    "vitest"
  ]
}
